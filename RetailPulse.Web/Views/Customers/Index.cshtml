@model IEnumerable<RetailPulse.Web.Models.Customer>

<div class="page-header">
    <div>
        <div class="page-header-meta">
            <span>Sales</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6" />
            </svg>
            <span>Customers</span>
        </div>
        <h1>Customers</h1>
        <p>Manage your customer base</p>
    </div>
    @if (PermissionService.HasPermission(User, "Customers", "Add"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Add Customer
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        @TempData["Success"]
    </div>
}

<div class="table-container animate-in">
    <div class="table-toolbar">
        <span class="table-count">@Model.Count() customers</span>
    </div>
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>City</th>
                    <th>Orders</th>
                    <th>Member Since</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <div style="width: 32px; height: 32px;
                                                background: var(--color-accent-dim);
                                                border: 1px solid rgba(34,197,94,0.2);
                                                border-radius: 50%;
                                                display: flex; align-items: center;
                                                justify-content: center;
                                                font-size: 12px; font-weight: 700;
                                                color: var(--color-accent);
                                                font-family: var(--font-heading);
                                                flex-shrink: 0;">
                                    @c.FullName.Substring(0, 1).ToUpper()
                                </div>
                                <span style="font-weight: 600;">@c.FullName</span>
                            </div>
                        </td>
                        <td style="color: var(--color-text-secondary); font-size: 12px;">
                            @(c.Email ?? "—")
                        </td>
                        <td style="color: var(--color-text-secondary); font-size: 12px;">
                            @(c.Phone ?? "—")
                        </td>
                        <td>@(c.City ?? "—")</td>
                        <td>
                            <span class="badge badge-blue">
                                @c.SalesOrders.Count orders
                            </span>
                        </td>
                        <td style="color: var(--color-text-faint);
                                       font-family: var(--font-mono); font-size: 12px;">
                            @c.CreatedAt.ToString("MMM d, yyyy")
                        </td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="Detail" asp-route-id="@c.CustomerId"
                                   class="btn btn-ghost"
                                   style="padding: 5px 10px; font-size: 12px;">View</a>
                                @if (PermissionService.HasPermission(User, "Customers", "Edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@c.CustomerId"
                                       class="btn btn-ghost"
                                       style="padding: 5px 10px; font-size: 12px;">Edit</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>