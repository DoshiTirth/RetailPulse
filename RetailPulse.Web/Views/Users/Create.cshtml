@{
    ViewData["Title"] = "Add User";
}

<div class="page-header">
    <div>
        <div class="page-header-meta">
            <span>User Management</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6" />
            </svg>
            <span>Add User</span>
        </div>
        <h1>Add User</h1>
        <p>Create a new system user</p>
    </div>
    <a asp-action="Index" class="btn btn-ghost">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12" />
            <polyline points="12 19 5 12 12 5" />
        </svg>
        Back
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        @TempData["Error"]
    </div>
}

<div class="card animate-in" style="max-width: 560px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="section-divider"><span>Account Info</span></div>

        <div class="grid-2">
            <div class="form-group">
                <label>Username</label>
                <input type="text" name="username"
                       placeholder="e.g. jsmith" required />
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email"
                       placeholder="user@retailpulse.com" required />
            </div>
        </div>

        <div class="section-divider"><span>Security</span></div>

        <div class="grid-2">
            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password"
                       placeholder="Min 8 characters" required />
            </div>
            <div class="form-group">
                <label>Role</label>
                <select name="roleId" required>
                    <option value="">-- Select Role --</option>
                    @foreach (SelectListItem item in ViewBag.Roles)
                    {
                        if (item.Selected)
                        {
                            <option value="@item.Value" selected>@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div style="display: flex; gap: 12px; margin-top: 8px;">
            <button type="submit" class="btn btn-primary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                    <polyline points="17 21 17 13 7 13 7 21" />
                    <polyline points="7 3 7 8 15 8" />
                </svg>
                Create User
            </button>
            <a asp-action="Index" class="btn btn-ghost">Cancel</a>
        </div>
    </form>
</div>