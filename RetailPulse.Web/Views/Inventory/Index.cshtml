@model IEnumerable<RetailPulse.Web.Models.Product>

<div class="page-header">
    <div>
        <div class="page-header-meta">
            <span>Inventory</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6" />
            </svg>
            <span>Stock & Restock</span>
        </div>
        <h1>Stock & Restock</h1>
        <p>Monitor inventory levels and restock products</p>
    </div>
    <a asp-action="History" class="btn btn-ghost">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
            <path d="M3 3h18v18H3zM3 9h18M9 21V9" />
        </svg>
        Restock History
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        @TempData["Error"]
    </div>
}

<!-- Stock Summary Cards -->
<div class="kpi-grid" style="margin-bottom: 24px;">
    <div class="kpi-card animate-in">
        <div style="display: flex; align-items: flex-start;
                    justify-content: space-between; margin-bottom: 12px;">
            <div class="kpi-label">Total Products</div>
            <div style="width: 36px; height: 36px; background: var(--color-accent-dim);
                        border-radius: var(--radius-md);
                        display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="var(--color-accent)" stroke-width="2">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                </svg>
            </div>
        </div>
        <div class="kpi-value">@Model.Count()</div>
        <div class="kpi-sub">active in catalogue</div>
        <div class="kpi-accent-bar" style="background: var(--color-accent);"></div>
    </div>

    <div class="kpi-card animate-in">
        <div style="display: flex; align-items: flex-start;
                    justify-content: space-between; margin-bottom: 12px;">
            <div class="kpi-label">Low Stock</div>
            <div style="width: 36px; height: 36px; background: var(--color-yellow-dim);
                        border-radius: var(--radius-md);
                        display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="var(--color-yellow)" stroke-width="2">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                    <line x1="12" y1="9" x2="12" y2="13" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
            </div>
        </div>
        <div class="kpi-value" style="color: var(--color-yellow);">
            @Model.Count(p => p.StockQuantity <= p.ReorderLevel && p.StockQuantity > 0)
        </div>
        <div class="kpi-sub">below reorder level</div>
        <div class="kpi-accent-bar" style="background: var(--color-yellow);"></div>
    </div>

    <div class="kpi-card animate-in">
        <div style="display: flex; align-items: flex-start;
                    justify-content: space-between; margin-bottom: 12px;">
            <div class="kpi-label">Out of Stock</div>
            <div style="width: 36px; height: 36px; background: var(--color-red-dim);
                        border-radius: var(--radius-md);
                        display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="var(--color-red)" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="15" y1="9" x2="9" y2="15" />
                    <line x1="9" y1="9" x2="15" y2="15" />
                </svg>
            </div>
        </div>
        <div class="kpi-value" style="color: var(--color-red);">
            @Model.Count(p => p.StockQuantity == 0)
        </div>
        <div class="kpi-sub">need immediate restock</div>
        <div class="kpi-accent-bar" style="background: var(--color-red);"></div>
    </div>

    <div class="kpi-card animate-in">
        <div style="display: flex; align-items: flex-start;
                    justify-content: space-between; margin-bottom: 12px;">
            <div class="kpi-label">Well Stocked</div>
            <div style="width: 36px; height: 36px; background: var(--color-green-dim);
                        border-radius: var(--radius-md);
                        display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="var(--color-green)" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
            </div>
        </div>
        <div class="kpi-value" style="color: var(--color-green);">
            @Model.Count(p => p.StockQuantity > p.ReorderLevel)
        </div>
        <div class="kpi-sub">above reorder level</div>
        <div class="kpi-accent-bar" style="background: var(--color-green);"></div>
    </div>
</div>

<div class="table-container animate-in">
    <div class="table-toolbar">
        <span class="table-count">@Model.Count() products</span>
    </div>
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Supplier</th>
                    <th>Stock</th>
                    <th>Reorder At</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td style="font-weight: 600;">@p.Name</td>
                        <td style="color: var(--color-text-secondary);">@p.Category.Name</td>
                        <td style="color: var(--color-text-secondary);">@p.Supplier.Name</td>
                        <td>
                            @if (p.StockQuantity == 0)
                            {
                                <span style="font-family: var(--font-mono);
                                                     color: var(--color-red); font-weight: 700;">0</span>
                            }
                            else if (p.StockQuantity <= p.ReorderLevel)
                            {
                                <span style="font-family: var(--font-mono);
                                                     color: var(--color-yellow); font-weight: 700;">
                                    @p.StockQuantity
                                </span>
                            }
                            else
                            {
                                <span style="font-family: var(--font-mono);
                                                     color: var(--color-green);">@p.StockQuantity</span>
                            }
                        </td>
                        <td style="font-family: var(--font-mono);
                                       color: var(--color-text-faint);">
                            @p.ReorderLevel
                        </td>
                        <td>
                            @if (p.StockQuantity == 0)
                            {
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span class="status-dot red"></span>
                                    <span class="badge badge-red">Out of Stock</span>
                                </div>
                            }
                            else if (p.StockQuantity <= p.ReorderLevel)
                            {
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span class="status-dot yellow"></span>
                                    <span class="badge badge-yellow">Low Stock</span>
                                </div>
                            }
                            else
                            {
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span class="status-dot green"></span>
                                    <span class="badge badge-green">OK</span>
                                </div>
                            }
                        </td>
                        <td>
                            @if (PermissionService.HasPermission(User, "Inventory", "Restock"))
                            {
                                <a asp-action="Restock" asp-route-id="@p.ProductId"
                                   class="btn btn-primary"
                                   style="padding: 5px 12px; font-size: 12px;">
                                    Restock
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>