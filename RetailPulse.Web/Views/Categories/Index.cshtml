@model IEnumerable<RetailPulse.Web.Models.Category>

<div class="page-header">
    <div>
        <div class="page-header-meta">
            <span>Catalogue</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6" />
            </svg>
            <span>Categories</span>
        </div>
        <h1>Categories</h1>
        <p>Manage product categories</p>
    </div>
    @if (PermissionService.HasPermission(User, "Categories", "Add"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Add Category
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        @TempData["Error"]
    </div>
}

<div class="table-container animate-in">
    <div class="table-toolbar">
        <span class="table-count">@Model.Count() categories</span>
    </div>
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Products</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td style="font-weight: 600;">@c.Name</td>
                        <td style="color: var(--color-text-secondary);">
                            @(c.Description ?? "—")
                        </td>
                        <td>
                            <span class="badge badge-blue">@c.Products.Count products</span>
                        </td>
                        <td>
                            <div class="btn-group">
                                @if (PermissionService.HasPermission(User, "Categories", "Edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@c.CategoryId"
                                       class="btn btn-ghost"
                                       style="padding: 5px 10px; font-size: 12px;">Edit</a>
                                }
                                @if (PermissionService.HasPermission(User, "Categories", "Delete"))
                                {
                                    <form asp-action="Delete" asp-route-id="@c.CategoryId"
                                          method="post" style="display:inline;"
                                          data-confirm
                                          data-confirm-title="Delete Category"
                                          data-confirm-message="Delete '@c.Name'? This cannot be undone."
                                          data-confirm-btn="Delete"
                                          data-confirm-danger="true">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger"
                                                style="padding: 5px 10px; font-size: 12px;">
                                            Delete
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>