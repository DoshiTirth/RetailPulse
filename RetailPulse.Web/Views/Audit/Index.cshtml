@model IEnumerable<RetailPulse.Web.Models.AuditLog>

<div class="page-header">
    <div>
        <div class="page-header-meta">
            <span>Administration</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6" />
            </svg>
            <span>Audit Log</span>
        </div>
        <h1>Audit Log</h1>
        <p>Track all system changes — who did what and when</p>
    </div>
</div>

<!-- Filters -->
<div class="card animate-in" style="margin-bottom: 16px; padding: 16px 20px;">
    <form asp-action="Index" method="get">
        <div class="filter-bar">
            <div class="filter-row">
                <div class="filter-field">
                    <label>MODULE</label>
                    <select name="module">
                        <option value="">All Modules</option>
                        @foreach (var m in (List<string>)ViewBag.Modules)
                        {
                            if (ViewBag.FilterModule == m)
                            {
                                <option value="@m" selected>@m</option>
                            }
                            else
                            {
                                <option value="@m">@m</option>
                            }
                        }
                    </select>
                </div>
                <div class="filter-field">
                    <label>ACTION</label>
                    <select name="action">
                        <option value="">All Actions</option>
                        @foreach (var a in (List<string>)ViewBag.Actions)
                        {
                            if (ViewBag.FilterAction == a)
                            {
                                <option value="@a" selected>@a</option>
                            }
                            else
                            {
                                <option value="@a">@a</option>
                            }
                        }
                    </select>
                </div>
                <div class="filter-field">
                    <label>USERNAME</label>
                    <input type="text" name="username" value="@ViewBag.FilterUsername"
                           placeholder="Filter by user..." />
                </div>
                <div class="filter-field">
                    <label>FROM DATE</label>
                    <input type="date" name="from" value="@ViewBag.FilterFrom" />
                </div>
                <div class="filter-field">
                    <label>TO DATE</label>
                    <input type="date" name="to" value="@ViewBag.FilterTo" />
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn btn-primary"
                            style="padding: 9px 16px;">
                        Filter
                    </button>
                    <a asp-action="Index" class="btn btn-ghost"
                       style="padding: 9px 16px;">Clear</a>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="table-container animate-in">
    <div class="table-toolbar">
        <span class="table-count">
            @ViewBag.Total total entries — page @ViewBag.Page of @ViewBag.TotalPages
        </span>
    </div>
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>User</th>
                    <th>Module</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>IP Address</th>
                    <th>Timestamp</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td style="font-family: var(--font-mono); font-size: 12px;
                                       color: var(--color-text-faint);">
                            @log.AuditId
                        </td>
                        <td>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <div style="width: 26px; height: 26px;
                                                background: var(--color-accent-dim);
                                                border-radius: 50%;
                                                display: flex; align-items: center;
                                                justify-content: center;
                                                font-size: 11px; font-weight: 700;
                                                color: var(--color-accent);
                                                font-family: var(--font-heading);
                                                flex-shrink: 0;">
                                    @log.Username.Substring(0, 1).ToUpper()
                                </div>
                                <span style="font-weight: 600; font-size: 13px;">
                                    @log.Username
                                </span>
                            </div>
                        </td>
                        <td>
                            <span class="badge badge-blue">@log.Module</span>
                        </td>
                        <td>
                            @{
                                var actionColor = log.Action switch
                                {
                                    "Create" => "badge-green",
                                    "Edit" => "badge-blue",
                                    "Delete" => "badge-red",
                                    "Deactivate" => "badge-yellow",
                                    "Activate" => "badge-green",
                                    "Restock" => "badge-green",
                                    _ => "badge-blue"
                                };
                            }
                            <span class="badge @actionColor">@log.Action</span>
                        </td>
                        <td>
                            @if (log.EntityName != null)
                            {
                                <span style="font-weight: 500;">@log.EntityName</span>
                                @if (log.EntityId.HasValue)
                                {
                                    <span style="font-family: var(--font-mono);
                                                             font-size: 11px;
                                                             color: var(--color-text-faint);
                                                             margin-left: 6px;">#@log.EntityId</span>
                                }
                            }
                            else
                            {
                                <span style="color: var(--color-text-faint);">—</span>
                            }
                        </td>
                        <td style="font-family: var(--font-mono); font-size: 12px;
                                       color: var(--color-text-faint);">
                            @(log.IpAddress ?? "—")
                        </td>
                        <td style="font-family: var(--font-mono); font-size: 12px;
                                       color: var(--color-text-faint);">
                            @log.CreatedAt.ToString("MMM d, yyyy h:mm tt")
                        </td>
                        <td>
                            @if (log.NewValues != null || log.OldValues != null)
                            {
                                <a asp-action="Detail" asp-route-id="@log.AuditId"
                                   class="btn btn-ghost"
                                   style="padding: 4px 10px; font-size: 11px;">
                                    View
                                </a>
                            }
                            else
                            {
                                <span style="color: var(--color-text-faint);">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div style="display: flex; align-items: center; justify-content: center;
                        gap: 8px; padding: 16px;">
            @if (ViewBag.Page > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.Page - 1)"
                   asp-route-module="@ViewBag.FilterModule"
                   asp-route-action="@ViewBag.FilterAction"
                   asp-route-username="@ViewBag.FilterUsername"
                   asp-route-from="@ViewBag.FilterFrom"
                   asp-route-to="@ViewBag.FilterTo"
                   class="btn btn-ghost" style="padding: 6px 12px; font-size: 12px;">
                    Previous
                </a>
            }
            <span style="font-size: 12px; color: var(--color-text-faint);
                             font-family: var(--font-mono);">
                @ViewBag.Page / @ViewBag.TotalPages
            </span>
            @if (ViewBag.Page < ViewBag.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.Page + 1)"
                   asp-route-module="@ViewBag.FilterModule"
                   asp-route-action="@ViewBag.FilterAction"
                   asp-route-username="@ViewBag.FilterUsername"
                   asp-route-from="@ViewBag.FilterFrom"
                   asp-route-to="@ViewBag.FilterTo"
                   class="btn btn-ghost" style="padding: 6px 12px; font-size: 12px;">
                    Next
                </a>
            }
        </div>
    }
</div>