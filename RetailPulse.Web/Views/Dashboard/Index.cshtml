@model RetailPulse.Web.Models.ViewModels.DashboardViewModel

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card animate-in">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12px;">
            <div class="kpi-label">Total Revenue</div>
            <div style="width: 36px; height: 36px; background: var(--color-accent-dim);
                        border-radius: var(--radius-md);
                        display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="var(--color-accent)" stroke-width="2">
                    <line x1="12" y1="1" x2="12" y2="23" />
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
            </div>
        </div>
        <div class="kpi-value" data-target="@Model.TotalRevenue" data-prefix="$" data-decimal="true">$0</div>
        <div style="display: flex; align-items: center; gap: 6px; margin-top: 8px;">
            <span class="kpi-sub">all completed orders</span>
        </div>
        <div class="kpi-accent-bar" style="background: var(--color-accent);"></div>
    </div>

    <div class="kpi-card animate-in">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12px;">
            <div class="kpi-label">Revenue (30 days)</div>
            <div style="width: 36px; height: 36px; background: var(--color-blue-dim);
                        border-radius: var(--radius-md);
                        display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="var(--color-blue)" stroke-width="2">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                    <polyline points="17 6 23 6 23 12" />
                </svg>
            </div>
        </div>
        <div class="kpi-value" data-target="@Model.RecentRevenue" data-prefix="$" data-decimal="true">$0</div>
        <div style="display: flex; align-items: center; gap: 6px; margin-top: 8px;">
            <span class="kpi-sub">last 30 days</span>
        </div>
        <div class="kpi-accent-bar" style="background: var(--color-blue);"></div>
    </div>

    <div class="kpi-card animate-in">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12px;">
            <div class="kpi-label">Pending Orders</div>
            <div style="width: 36px; height: 36px; background: var(--color-yellow-dim);
                        border-radius: var(--radius-md);
                        display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="var(--color-yellow)" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
            </div>
        </div>
        <div class="kpi-value" data-target="@Model.PendingOrders">0</div>
        <div style="display: flex; align-items: center; gap: 6px; margin-top: 8px;">
            <span class="kpi-sub">awaiting processing</span>
        </div>
        <div class="kpi-accent-bar" style="background: var(--color-yellow);"></div>
    </div>

    <div class="kpi-card animate-in">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12px;">
            <div class="kpi-label">Low Stock Alerts</div>
            <div style="width: 36px; height: 36px; background: var(--color-red-dim);
                        border-radius: var(--radius-md);
                        display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="var(--color-red)" stroke-width="2">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                    <line x1="12" y1="9" x2="12" y2="13" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
            </div>
        </div>
        <div class="kpi-value" data-target="@Model.LowStockCount">0</div>
        <div style="display: flex; align-items: center; gap: 6px; margin-top: 8px;">
            <span class="kpi-sub">below reorder level</span>
        </div>
        <div class="kpi-accent-bar" style="background: var(--color-red);"></div>
    </div>

    <div class="kpi-card animate-in">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12px;">
            <div class="kpi-label">Active Products</div>
            <div style="width: 36px; height: 36px; background: var(--color-accent-dim);
                        border-radius: var(--radius-md);
                        display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="var(--color-accent)" stroke-width="2">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                </svg>
            </div>
        </div>
        <div class="kpi-value" data-target="@Model.TotalProducts">0</div>
        <div style="display: flex; align-items: center; gap: 6px; margin-top: 8px;">
            <span class="kpi-sub">in catalogue</span>
        </div>
        <div class="kpi-accent-bar" style="background: var(--color-accent);"></div>
    </div>

    <div class="kpi-card animate-in">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12px;">
            <div class="kpi-label">Customers</div>
            <div style="width: 36px; height: 36px; background: var(--color-blue-dim);
                        border-radius: var(--radius-md);
                        display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="var(--color-blue)" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </div>
        </div>
        <div class="kpi-value" data-target="@Model.TotalCustomers">0</div>
        <div style="display: flex; align-items: center; gap: 6px; margin-top: 8px;">
            <span class="kpi-sub">registered customers</span>
        </div>
        <div class="kpi-accent-bar" style="background: var(--color-blue);"></div>
    </div>
</div>

<!-- Charts + Low Stock -->
<div class="grid-2" style="margin-bottom: 24px;">

    <!-- Revenue Chart -->
    <div class="card animate-in">
        <div class="card-header">
            <span class="card-title">Monthly Revenue</span>
            <span style="font-size:11px; color: var(--text-faint); font-family: var(--font-mono);">last 6 months</span>
        </div>
        <canvas id="revenueChart" height="200"></canvas>
    </div>

    <!-- Low Stock -->
    <div class="card animate-in">
        <div class="card-header">
            <span class="card-title">Low Stock Alerts</span>
            <a asp-controller="Inventory" asp-action="Index" style="font-size:12px;">View all</a>
        </div>
        @if (Model.LowStockProducts.Any())
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Stock</th>
                            <th>Reorder At</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.LowStockProducts)
                        {
                            <tr>
                                <td>@p.Name</td>
                                <td style="font-family: var(--font-mono);">@p.StockQuantity</td>
                                <td style="font-family: var(--font-mono);">@p.ReorderLevel</td>
                                <td>
                                    @if (p.StockQuantity == 0)
                                    {
                                        <span class="badge badge-red">Out of Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-yellow">Low</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p style="color: var(--text-faint); font-size: 13px;">All products are well stocked.</p>
        }
    </div>
</div>

<!-- Recent Orders -->
<div class="card animate-in">
    <div class="card-header">
        <span class="card-title">Recent Orders</span>
        <a asp-controller="Orders" asp-action="Index" style="font-size:12px;">View all</a>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.RecentOrders)
                {
                    <tr>
                        <td style="font-family: var(--font-mono);">#@order.OrderId</td>
                        <td>@order.Customer.FullName</td>
                        <td style="color: var(--text-secondary);">@order.OrderDate.ToString("MMM d, yyyy")</td>
                        <td style="font-family: var(--font-mono);">$@order.TotalAmount.ToString("N2")</td>
                        <td>
                            @switch (order.Status)
                            {
                                case "Completed":
                                    <span class="badge badge-green">Completed</span>
                                    break;
                                case "Pending":
                                    <span class="badge badge-yellow">Pending</span>
                                    break;
                                case "Cancelled":
                                    <span class="badge badge-red">Cancelled</span>
                                    break;
                                default:
                                    <span class="badge badge-blue">@order.Status</span>
                                    break;
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        const labels  = [@Html.Raw(string.Join(",", Model.MonthlyRevenue.Select(x => $"\"{x.Label}\"")))];
        const revenue = [@Html.Raw(string.Join(",", Model.MonthlyRevenue.Select(x => x.Revenue.ToString("F2"))))];

        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Revenue ($)',
                    data: revenue,
                    backgroundColor: 'rgba(79, 142, 247, 0.25)',
                    borderColor: 'rgba(79, 142, 247, 0.9)',
                    borderWidth: 2,
                    borderRadius: 6,
                }]
            },
            options: {
                responsive: true,
                animation: { duration: 900, easing: 'easeOutQuart' },
                plugins: { legend: { display: false } },
                scales: {
                    x: {
                        ticks: { color: '#9099b0', font: { size: 11 } },
                        grid:  { color: 'rgba(255,255,255,0.04)' }
                    },
                    y: {
                        ticks: {
                            color: '#9099b0', font: { size: 11 },
                            callback: v => '$' + v.toLocaleString()
                        },
                        grid: { color: 'rgba(255,255,255,0.04)' }
                    }
                }
            }
        });
    </script>
}