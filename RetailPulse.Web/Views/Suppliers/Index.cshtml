@model IEnumerable<RetailPulse.Web.Models.Supplier>

<div class="page-header">
    <div>
        <div class="page-header-meta">
            <span>Catalogue</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6" />
            </svg>
            <span>Suppliers</span>
        </div>
        <h1>Suppliers</h1>
        <p>Manage your supplier network</p>
    </div>
    @if (PermissionService.HasPermission(User, "Suppliers", "Add"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Add Supplier
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        @TempData["Error"]
    </div>
}

<div class="table-container animate-in">
    <div class="table-toolbar">
        <span class="table-count">@Model.Count() suppliers</span>
    </div>
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Supplier</th>
                    <th>Contact</th>
                    <th>Email</th>
                    <th>Country</th>
                    <th>Products</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td style="font-weight: 600;">@s.Name</td>
                        <td style="color: var(--color-text-secondary);">
                            @(s.ContactName ?? "—")
                        </td>
                        <td style="color: var(--color-text-secondary); font-size: 12px;">
                            @(s.Email ?? "—")
                        </td>
                        <td>@(s.Country ?? "—")</td>
                        <td>
                            <span class="badge badge-blue">
                                @s.Products.Count products
                            </span>
                        </td>
                        <td>
                            @if (s.IsActive)
                            {
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span class="status-dot green"></span>
                                    <span class="badge badge-green">Active</span>
                                </div>
                            }
                            else
                            {
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span class="status-dot red"></span>
                                    <span class="badge badge-red">Inactive</span>
                                </div>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                @if (PermissionService.HasPermission(User, "Suppliers", "Edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@s.SupplierId"
                                       class="btn btn-ghost"
                                       style="padding: 5px 10px; font-size: 12px;">Edit</a>
                                }
                                @if (PermissionService.HasPermission(User, "Suppliers", "Deactivate"))
                                {
                                    <form asp-action="ToggleActive" asp-route-id="@s.SupplierId"
                                          method="post" style="display:inline;"
                                          data-confirm
                                          data-confirm-title="@(s.IsActive ? "Deactivate Supplier" : "Activate Supplier")"
                                          data-confirm-message="@(s.IsActive ? $"Deactivate {s.Name}?" : $"Activate {s.Name}?")"
                                          data-confirm-btn="@(s.IsActive ? "Deactivate" : "Activate")"
                                          data-confirm-danger="@(s.IsActive ? "true" : "false")">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn @(s.IsActive ? "btn-danger" : "btn-primary")"
                                                style="padding: 5px 10px; font-size: 12px;">
                                            @(s.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>