@{
    var code = Context.Response.StatusCode;
    var title = code switch
    {
        404 => "Page Not Found",
        403 => "Access Denied",
        500 => "Server Error",
        _ => "Something Went Wrong"
    };
    var message = code switch
    {
        404 => "The page you're looking for doesn't exist or has been moved.",
        403 => "You don't have permission to access this page.",
        500 => "An internal server error occurred. Please try again.",
        _ => "An unexpected error occurred."
    };
    var icon = code switch
    {
        404 => "M9.172 16.172a4 4 0 0 1 5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z",
        403 => "M12 15v2m-6 4h12a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2zm10-10V7a4 4 0 0 0-8 0v4h8z",
        _ => "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
    };
    ViewData["Title"] = title;
    ViewData["ActivePage"] = "";
}

<div style="display: flex; flex-direction: column; align-items: center;
            justify-content: center; min-height: 60vh; text-align: center;
            padding: 24px;">

    <!-- Error Code -->
    <div style="font-size: 96px; font-weight: 800;
                font-family: var(--font-mono);
                background: linear-gradient(135deg, var(--color-accent), var(--color-blue));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                line-height: 1;
                margin-bottom: 24px;
                opacity: 0.6;">
        @code
    </div>

    <!-- Icon -->
    <div style="width: 64px; height: 64px;
                background: var(--color-secondary);
                border: 1px solid var(--color-border);
                border-radius: var(--radius-xl);
                display: flex; align-items: center; justify-content: center;
                margin-bottom: 20px;
                box-shadow: var(--shadow-md);">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
             stroke="var(--color-text-faint)" stroke-width="1.5">
            <path d="@icon" />
        </svg>
    </div>

    <h1 style="font-size: 24px; font-weight: 700; margin-bottom: 12px;
               font-family: var(--font-heading);">
        @title
    </h1>

    <p style="color: var(--color-text-faint); font-size: 14px;
              max-width: 400px; margin-bottom: 32px; line-height: 1.7;">
        @message
    </p>

    <div class="btn-group" style="justify-content: center;">
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
            Back to Dashboard
        </a>
        <button onclick="history.back()" class="btn btn-ghost">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12" />
                <polyline points="12 19 5 12 12 5" />
            </svg>
            Go Back
        </button>
    </div>
</div>