@{
    ViewData["Title"] = "API Documentation";
}

<div class="page-header">
    <div>
        <div class="page-header-meta">
            <span>Administration</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6" />
            </svg>
            <span>API Docs</span>
        </div>
        <h1>REST API Documentation</h1>
        <p>JSON endpoints for RetailPulse ERP integration</p>
    </div>
    <div style="display: flex; align-items: center; gap: 8px;
                background: var(--color-accent-dim);
                border: 1px solid rgba(34,197,94,0.2);
                border-radius: var(--radius-md);
                padding: 8px 14px;">
        <div style="width: 8px; height: 8px; background: var(--color-accent);
                    border-radius: 50; animation: pulse 2s infinite;"></div>
        <span style="font-size: 12px; font-weight: 600;
                     color: var(--color-accent); font-family: var(--font-mono);">
            API ACTIVE
        </span>
    </div>
</div>

<!-- Base URL -->
<div class="card animate-in" style="margin-bottom: 24px;">
    <div class="card-header">
        <span class="card-title">Base URL</span>
    </div>
    <div style="background: var(--color-secondary); border-radius: var(--radius-md);
                padding: 14px 18px; font-family: var(--font-mono); font-size: 13px;
                color: var(--color-accent);">
        https://localhost:7291/api
    </div>
    <div style="margin-top: 12px; font-size: 13px; color: var(--color-text-faint);">
        All endpoints require authentication via session cookie. Login at
        <span style="font-family: var(--font-mono); color: var(--color-accent);">
            /Auth/Login
        </span>
        first.
    </div>
</div>

@{
    var endpoints = new[]
    {
        new { Method = "GET", Path = "/api/dashboard/summary", Description = "KPI summary — revenue, orders, stock counts", Params = "none" },
        new { Method = "GET", Path = "/api/products", Description = "List all products", Params = "search, category, active" },
        new { Method = "GET", Path = "/api/products/{id}", Description = "Get single product by ID", Params = "none" },
        new { Method = "GET", Path = "/api/orders", Description = "List all orders", Params = "status, from, to" },
        new { Method = "GET", Path = "/api/orders/{id}", Description = "Get order with line items", Params = "none" },
        new { Method = "GET", Path = "/api/customers", Description = "List all customers", Params = "search" },
        new { Method = "GET", Path = "/api/inventory/lowstock", Description = "Products below reorder level", Params = "none" },
        new { Method = "GET", Path = "/api/inventory/summary", Description = "Inventory stock summary", Params = "none" },
    };
}

<div class="table-container animate-in">
    <div class="table-toolbar">
        <span class="table-count">@endpoints.Length endpoints</span>
    </div>
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Method</th>
                    <th>Endpoint</th>
                    <th>Description</th>
                    <th>Query Params</th>
                    <th>Try It</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ep in endpoints)
                {
                    <tr>
                        <td>
                            <span class="badge badge-green"
                                  style="font-family: var(--font-mono);">
                                @ep.Method
                            </span>
                        </td>
                        <td style="font-family: var(--font-mono); font-size: 12px;
                                       color: var(--color-accent);">
                            @ep.Path
                        </td>
                        <td style="color: var(--color-text-secondary);">
                            @ep.Description
                        </td>
                        <td style="font-family: var(--font-mono); font-size: 12px;
                                       color: var(--color-text-faint);">
                            @ep.Params
                        </td>
                        <td>
                            <a href="@ep.Path.Replace("{id}", "1")"
                               target="_blank" class="btn btn-ghost"
                               style="padding: 4px 10px; font-size: 11px;">
                                Open
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Example Responses -->
<div class="grid-2" style="margin-top: 24px;">
    <div class="card animate-in">
        <div class="card-header">
            <span class="card-title">Example — Dashboard Summary</span>
        </div>
        <pre style="background: var(--color-secondary);
                    border-radius: var(--radius-md);
                    padding: 16px; font-family: var(--font-mono);
                    font-size: 11px; color: var(--color-text-primary);
                    overflow-x: auto; line-height: 1.8;">{
  "totalRevenue": 1859.80,
  "recentRevenue": 934.89,
  "pendingOrders": 4,
  "totalProducts": 15,
  "lowStockCount": 4,
  "totalCustomers": 8,
  "generatedAt": "2026-04-21T20:00:00Z"
}</pre>
    </div>

    <div class="card animate-in">
        <div class="card-header">
            <span class="card-title">Example — Products List</span>
        </div>
        <pre style="background: var(--color-secondary);
                    border-radius: var(--radius-md);
                    padding: 16px; font-family: var(--font-mono);
                    font-size: 11px; color: var(--color-text-primary);
                    overflow-x: auto; line-height: 1.8;">{
  "count": 15,
  "data": [
    {
      "productId": 1,
      "name": "Wireless Headphones",
      "sku": "ELEC-001",
      "category": "Electronics",
      "unitPrice": 89.99,
      "stockQuantity": 45,
      "isLowStock": false
    }
  ]
}</pre>
    </div>
</div>