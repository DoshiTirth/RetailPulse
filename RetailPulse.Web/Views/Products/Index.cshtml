@model IEnumerable<RetailPulse.Web.Models.Product>

<div class="page-header">
    <div>
        <div class="page-header-meta">
            <span>Catalogue</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6" />
            </svg>
            <span>Products</span>
        </div>
        <h1>Products</h1>
        <p>Manage your product catalogue</p>
    </div>
    <div style="display: flex; gap: 10px;">
        @if (PermissionService.HasPermission(User, "Products", "Add"))
        {
            <a asp-controller="Import" asp-action="Products" class="btn btn-ghost">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7 10 12 15 17 10" />
                    <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                Import CSV
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Add Product
            </a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        @TempData["Error"]
    </div>
}

<!-- Filter Bar -->
<div class="card animate-in" style="margin-bottom: 16px; padding: 16px 20px;">
    <form asp-action="Index" method="get">
        <div class="filter-bar">
            <div class="filter-row">
                <div class="filter-field" style="max-width: 400px;">
                    <label>SEARCH</label>
                    <div class="input-group">
                        <svg class="input-icon" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8" />
                            <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                        <input type="text" name="search" value="@ViewBag.FilterSearch"
                               placeholder="Search name or SKU..." />
                    </div>
                </div>
                <div class="filter-field">
                    <label>CATEGORY</label>
                    <select name="category">
                        <option value="">All Categories</option>
                        @foreach (var c in (List<RetailPulse.Web.Models.Category>)ViewBag.Categories)
                        {
                            if (ViewBag.FilterCat == c.Name)
                            {
                                <option value="@c.Name" selected>@c.Name</option>
                            }
                            else
                            {
                                <option value="@c.Name">@c.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="filter-field">
                    <label>STATUS</label>
                    <select name="status">
                        <option value="">All</option>
                        @if (ViewBag.FilterStatus == "active")
                        {
                            <option value="active" selected>Active</option>
                            <option value="inactive">Inactive</option>
                        }
                        else if (ViewBag.FilterStatus == "inactive")
                        {
                            <option value="active">Active</option>
                            <option value="inactive" selected>Inactive</option>
                        }
                        else
                        {
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        }
                    </select>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn btn-primary"
                            style="padding: 9px 16px;">
                        Filter
                    </button>
                    <a asp-action="Index" class="btn btn-ghost"
                       style="padding: 9px 16px;">Clear</a>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Table -->
<div class="table-container animate-in">
    <div class="table-toolbar">
        <span class="table-count">
            Showing @Model.Count() product(s)
        </span>
    </div>
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Supplier</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <div style="font-weight: 600;">@p.Name</div>
                        </td>
                        <td>
                            <span style="font-family: var(--font-mono);
                                             font-size: 12px;
                                             color: var(--color-text-faint);
                                             background: var(--color-secondary);
                                             padding: 2px 8px;
                                             border-radius: var(--radius-sm);">
                                @p.SKU
                            </span>
                        </td>
                        <td style="color: var(--color-text-secondary);">
                            @p.Category.Name
                        </td>
                        <td style="color: var(--color-text-secondary);">
                            @p.Supplier.Name
                        </td>
                        <td style="font-family: var(--font-mono); font-weight: 600;">
                            $@p.UnitPrice.ToString("N2")
                        </td>
                        <td>
                            @if (p.StockQuantity <= p.ReorderLevel)
                            {
                                <span style="font-family: var(--font-mono);
                                                     color: var(--color-red);
                                                     font-weight: 700;">@p.StockQuantity</span>
                            }
                            else
                            {
                                <span style="font-family: var(--font-mono);">
                                    @p.StockQuantity
                                </span>
                            }
                        </td>
                        <td>
                            @if (p.IsActive)
                            {
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span class="status-dot green"></span>
                                    <span class="badge badge-green">Active</span>
                                </div>
                            }
                            else
                            {
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span class="status-dot red"></span>
                                    <span class="badge badge-red">Inactive</span>
                                </div>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                @if (PermissionService.HasPermission(User, "Products", "Edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@p.ProductId"
                                       class="btn btn-ghost"
                                       style="padding: 5px 10px; font-size: 12px;">Edit</a>
                                }
                                @if (PermissionService.HasPermission(User, "Products", "Deactivate"))
                                {
                                    <form method="post"
                                          action="/Products/ToggleActive/@p.ProductId"
                                          style="display:inline;"
                                          data-confirm
                                          data-confirm-title="@(p.IsActive ? "Deactivate Product" : "Activate Product")"
                                          data-confirm-message="@(p.IsActive ? $"Deactivate {p.Name}?" : $"Activate {p.Name}?")"
                                          data-confirm-btn="@(p.IsActive ? "Deactivate" : "Activate")"
                                          data-confirm-danger="@(p.IsActive ? "true" : "false")">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn @(p.IsActive ? "btn-danger" : "btn-primary")"
                                                style="padding: 5px 10px; font-size: 12px;">
                                            @(p.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                }
                                @if (PermissionService.HasPermission(User, "Products", "Delete"))
                                {
                                    <form method="post"
                                          action="/Products/Delete/@p.ProductId"
                                          style="display:inline;"
                                          data-confirm
                                          data-confirm-title="Delete Product"
                                          data-confirm-message="Permanently delete '@p.Name'? This cannot be undone."
                                          data-confirm-btn="Delete"
                                          data-confirm-danger="true">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger"
                                                style="padding: 5px 10px; font-size: 12px;
                                                               background: #7f1d1d;">
                                            Delete
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>