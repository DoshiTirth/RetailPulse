@model RetailPulse.Web.Models.ViewModels.DashboardViewModel
@{
    var widgets = (dynamic)ViewBag.Widgets;
    bool IsVisible(string key)
    {
        foreach (var w in widgets)
        {
            if (w.Key == key) return w.IsVisible;
        }
        return true;
    }
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        @TempData["Success"]
    </div>
}

<!-- Customize Button -->
<div style="display: flex; justify-content: flex-end; margin-bottom: 20px;">
    <button onclick="toggleCustomize()" class="btn btn-ghost" style="gap: 8px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
        Customize Dashboard
    </button>
</div>

<!-- Customize Panel -->
<div id="customizePanel" style="display: none; margin-bottom: 24px;">
    <div class="card animate-in">
        <div class="card-header">
            <span class="card-title">Dashboard Widgets</span>
            <span style="font-size: 12px; color: var(--color-text-faint);">
                Toggle widgets on or off
            </span>
        </div>
        <form asp-action="SaveWidgets" method="post">
            @Html.AntiForgeryToken()
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
                        gap: 10px; margin-bottom: 20px;">
                @foreach (var w in widgets)
                {
                    <label style="display: flex; align-items: center; gap: 10px;
                                       padding: 12px; background: var(--color-secondary);
                                       border-radius: var(--radius-md); cursor: pointer;
                                       border: 1px solid var(--color-border);
                                       transition: border-color var(--transition-fast);">
                        <input type="checkbox" name="visibleWidgets" value="@w.Key"
                               @(w.IsVisible ? "checked" : "")
                               style="width: 16px; height: 16px;
                                          accent-color: var(--color-accent);" />
                        <span style="font-size: 13px; font-weight: 500;">@w.Label</span>
                    </label>
                }
            </div>
            <div style="display: flex; gap: 10px;">
                <button type="submit" class="btn btn-primary">Save Layout</button>
                <button type="button" onclick="toggleCustomize()"
                        class="btn btn-ghost">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

<!-- KPI Cards -->
@if (IsVisible("kpi_revenue") || IsVisible("kpi_recent_revenue") ||
     IsVisible("kpi_pending_orders") || IsVisible("kpi_low_stock") ||
     IsVisible("kpi_products") || IsVisible("kpi_customers"))
{
    <div class="kpi-grid">
        @if (IsVisible("kpi_revenue"))
        {
            <div class="kpi-card animate-in">
                <div style="display: flex; align-items: flex-start;
                                    justify-content: space-between; margin-bottom: 12px;">
                    <div class="kpi-label">Total Revenue</div>
                    <div style="width: 36px; height: 36px; background: var(--color-accent-dim);
                                        border-radius: var(--radius-md);
                                        display: flex; align-items: center; justify-content: center;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="var(--color-accent)" stroke-width="2">
                            <line x1="12" y1="1" x2="12" y2="23" />
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                        </svg>
                    </div>
                </div>
                <div class="kpi-value" data-target="@Model.TotalRevenue"
                     data-prefix="$" data-decimal="true">
                    $0
                </div>
                <div class="kpi-sub">all completed orders</div>
                <div class="kpi-accent-bar" style="background: var(--color-accent);"></div>
            </div>
        }
        @if (IsVisible("kpi_recent_revenue"))
        {
            <div class="kpi-card animate-in">
                <div style="display: flex; align-items: flex-start;
                                    justify-content: space-between; margin-bottom: 12px;">
                    <div class="kpi-label">Revenue (30 days)</div>
                    <div style="width: 36px; height: 36px; background: var(--color-blue-dim);
                                        border-radius: var(--radius-md);
                                        display: flex; align-items: center; justify-content: center;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="var(--color-blue)" stroke-width="2">
                            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                            <polyline points="17 6 23 6 23 12" />
                        </svg>
                    </div>
                </div>
                <div class="kpi-value" data-target="@Model.RecentRevenue"
                     data-prefix="$" data-decimal="true">
                    $0
                </div>
                <div class="kpi-sub">last 30 days</div>
                <div class="kpi-accent-bar" style="background: var(--color-blue);"></div>
            </div>
        }
        @if (IsVisible("kpi_pending_orders"))
        {
            <div class="kpi-card animate-in">
                <div style="display: flex; align-items: flex-start;
                                    justify-content: space-between; margin-bottom: 12px;">
                    <div class="kpi-label">Pending Orders</div>
                    <div style="width: 36px; height: 36px; background: var(--color-yellow-dim);
                                        border-radius: var(--radius-md);
                                        display: flex; align-items: center; justify-content: center;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="var(--color-yellow)" stroke-width="2">
                            <circle cx="12" cy="12" r="10" />
                            <polyline points="12 6 12 12 16 14" />
                        </svg>
                    </div>
                </div>
                <div class="kpi-value" data-target="@Model.PendingOrders">0</div>
                <div class="kpi-sub">awaiting processing</div>
                <div class="kpi-accent-bar" style="background: var(--color-yellow);"></div>
            </div>
        }
        @if (IsVisible("kpi_low_stock"))
        {
            <div class="kpi-card animate-in">
                <div style="display: flex; align-items: flex-start;
                                    justify-content: space-between; margin-bottom: 12px;">
                    <div class="kpi-label">Low Stock Alerts</div>
                    <div style="width: 36px; height: 36px; background: var(--color-red-dim);
                                        border-radius: var(--radius-md);
                                        display: flex; align-items: center; justify-content: center;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="var(--color-red)" stroke-width="2">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                            <line x1="12" y1="9" x2="12" y2="13" />
                            <line x1="12" y1="17" x2="12.01" y2="17" />
                        </svg>
                    </div>
                </div>
                <div class="kpi-value" data-target="@Model.LowStockCount">0</div>
                <div class="kpi-sub">below reorder level</div>
                <div class="kpi-accent-bar" style="background: var(--color-red);"></div>
            </div>
        }
        @if (IsVisible("kpi_products"))
        {
            <div class="kpi-card animate-in">
                <div style="display: flex; align-items: flex-start;
                                    justify-content: space-between; margin-bottom: 12px;">
                    <div class="kpi-label">Active Products</div>
                    <div style="width: 36px; height: 36px; background: var(--color-accent-dim);
                                        border-radius: var(--radius-md);
                                        display: flex; align-items: center; justify-content: center;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="var(--color-accent)" stroke-width="2">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                        </svg>
                    </div>
                </div>
                <div class="kpi-value" data-target="@Model.TotalProducts">0</div>
                <div class="kpi-sub">in catalogue</div>
                <div class="kpi-accent-bar" style="background: var(--color-accent);"></div>
            </div>
        }
        @if (IsVisible("kpi_customers"))
        {
            <div class="kpi-card animate-in">
                <div style="display: flex; align-items: flex-start;
                                    justify-content: space-between; margin-bottom: 12px;">
                    <div class="kpi-label">Customers</div>
                    <div style="width: 36px; height: 36px; background: var(--color-blue-dim);
                                        border-radius: var(--radius-md);
                                        display: flex; align-items: center; justify-content: center;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="var(--color-blue)" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                    </div>
                </div>
                <div class="kpi-value" data-target="@Model.TotalCustomers">0</div>
                <div class="kpi-sub">registered customers</div>
                <div class="kpi-accent-bar" style="background: var(--color-blue);"></div>
            </div>
        }
    </div>
}

<!-- Charts + Low Stock -->
@if (IsVisible("chart_revenue") || IsVisible("panel_low_stock"))
{
    <div class="grid-2" style="margin-bottom: 24px;">
        @if (IsVisible("chart_revenue"))
        {
            <div class="card animate-in">
                <div class="card-header">
                    <span class="card-title">Monthly Revenue</span>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <div style="width: 8px; height: 8px;
                                            background: var(--color-accent);
                                            border-radius: 50%;"></div>
                        <span style="font-size:11px; color: var(--color-text-faint);
                                             font-family: var(--font-mono);">last 6 months</span>
                    </div>
                </div>
                <canvas id="revenueChart" height="200"></canvas>
            </div>
        }
        @if (IsVisible("panel_low_stock"))
        {
            <div class="card animate-in">
                <div class="card-header">
                    <span class="card-title">Low Stock Alerts</span>
                    <a asp-controller="Inventory" asp-action="Index"
                       style="font-size:12px; color: var(--color-accent);">View all</a>
                </div>
                @if (Model.LowStockProducts.Any())
                {
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Stock</th>
                                    <th>Reorder</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.LowStockProducts)
                                {
                                    <tr>
                                        <td style="font-weight: 600;">@p.Name</td>
                                        <td style="font-family: var(--font-mono);">
                                            @p.StockQuantity
                                        </td>
                                        <td style="font-family: var(--font-mono);
                                                                   color: var(--color-text-faint);">
                                            @p.ReorderLevel
                                        </td>
                                        <td>
                                            @if (p.StockQuantity == 0)
                                            {
                                                <span class="badge badge-red">Out</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-yellow">Low</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.5">
                            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <p>All products are well stocked.</p>
                    </div>
                }
            </div>
        }
    </div>
}

<!-- Recent Orders -->
@if (IsVisible("table_orders"))
{
    <div class="card animate-in">
        <div class="card-header">
            <span class="card-title">Recent Orders</span>
            <a asp-controller="Orders" asp-action="Index"
               style="font-size:12px; color: var(--color-accent);">View all</a>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr>
                            <td style="font-family: var(--font-mono); font-weight: 600;
                                               color: var(--color-accent);">
                                #@order.OrderId
                            </td>
                            <td style="font-weight: 500;">@order.Customer.FullName</td>
                            <td style="color: var(--color-text-faint);
                                               font-family: var(--font-mono); font-size: 12px;">
                                @order.OrderDate.ToString("MMM d, yyyy")
                            </td>
                            <td style="font-family: var(--font-mono); font-weight: 600;">
                                $@order.TotalAmount.ToString("N2")
                            </td>
                            <td>
                                @switch (order.Status)
                                {
                                    case "Completed":
                                        <div style="display:flex;align-items:center;gap:6px;">
                                            <span class="status-dot green"></span>
                                            <span class="badge badge-green">Completed</span>
                                        </div>
                                        break;
                                    case "Pending":
                                        <div style="display:flex;align-items:center;gap:6px;">
                                            <span class="status-dot yellow"></span>
                                            <span class="badge badge-yellow">Pending</span>
                                        </div>
                                        break;
                                    case "Cancelled":
                                        <div style="display:flex;align-items:center;gap:6px;">
                                            <span class="status-dot red"></span>
                                            <span class="badge badge-red">Cancelled</span>
                                        </div>
                                        break;
                                    default:
                                        <span class="badge badge-blue">@order.Status</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        // Customize panel toggle
        function toggleCustomize() {
            const panel = document.getElementById('customizePanel');
            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        }

        // Revenue Chart
        @if (IsVisible("chart_revenue"))
        {
                <text>
                const labels  = [@Html.Raw(string.Join(",", Model.MonthlyRevenue.Select(x => $"\"{x.Label}\"")))];
                const revenue = [@Html.Raw(string.Join(",", Model.MonthlyRevenue.Select(x => x.Revenue.ToString("F2"))))];

                new Chart(document.getElementById('revenueChart'), {
                    type: 'bar',
                    data: {
                        labels,
                        datasets: [{
                            label: 'Revenue ($)',
                            data: revenue,
                            backgroundColor: 'rgba(34, 197, 94, 0.15)',
                            borderColor: 'rgba(34, 197, 94, 0.8)',
                            borderWidth: 2,
                            borderRadius: 8,
                            borderSkipped: false,
                            hoverBackgroundColor: 'rgba(34, 197, 94, 0.3)',
                        }]
                    },
                    options: {
                        responsive: true,
                        animation: { duration: 900, easing: 'easeOutQuart' },
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#0F172A',
                                borderColor: '#334155',
                                borderWidth: 1,
                                titleColor: '#94A3B8',
                                bodyColor: '#F8FAFC',
                                padding: 12,
                                cornerRadius: 8,
                                callbacks: {
                                    label: ctx => ' $' + ctx.parsed.y.toLocaleString('en-CA',
                                        { minimumFractionDigits: 2 })
                                }
                            }
                        },
                        scales: {
                            x: {
                                ticks: { color: '#64748B', font: { size: 11, family: 'Nunito Sans' } },
                                grid: { color: 'rgba(51,65,85,0.4)' },
                                border: { color: 'transparent' }
                            },
                            y: {
                                ticks: {
                                    color: '#64748B',
                                    font: { size: 11, family: 'Nunito Sans' },
                                    callback: v => '$' + v.toLocaleString()
                                },
                                grid: { color: 'rgba(51,65,85,0.4)' },
                                border: { color: 'transparent' }
                            }
                        }
                    }
                });
                </text>
        }
    </script>
}